# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
.venv/
backend/.venv/
env/
venv/
ENV/

# Python packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Datasets (do not commit raw datasets)
data/raw/
data/processed/
TRAIN/archive/
TRAIN/archive.zip
*.zip

# Model checkpoints (do not commit trained model weights)
models/global/*
models/client/*
models/checkpoints/*
!models/global/.gitkeep
!models/client/.gitkeep
!models/checkpoints/.gitkeep

# Experiment Runs & Generated Results
experiments/runs/*
!experiments/runs/.gitkeep
results/metrics/*
!results/metrics/.gitkeep
results/plots/*
!results/plots/.gitkeep

# IDEs & System
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
